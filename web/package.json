  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "playwright-core": "^1.63.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.1",
    "vitest": "^4.0.0"
  }
}
